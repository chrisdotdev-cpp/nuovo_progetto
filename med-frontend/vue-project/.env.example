# URL base delle API Laravel.
# In sviluppo si lascia /api/v1 e ci pensa il proxy di Vite (vite.config.js).
VITE_API_URL=/api/v1

# Backend usato dal proxy in sviluppo
VITE_PROXY_TARGET=http://localhost:8000

# Nome dispositivo inviato al login: identifica il token lato Sanctum
VITE_DEVICE_NAME=web
